{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://void-painter.local/schemas/scene.schema.json",
  "title": "장면 정의 (game/data/scenes/<scene_id>.json)",
  "description": "ChapterScene 이 읽어 장면을 만든다. 좌표는 480×270 픽셀. 배경 메타데이터(game/art/bg/<background>.json)의 walkable/blockers/spawns/exits/props 를 기본으로 쓰고, 여기 값이 있으면 덮어쓴다/더한다.",
  "type": "object",
  "required": [
    "scene_id",
    "background",
    "characters"
  ],
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string"
    },
    "scene_id": {
      "type": "string",
      "pattern": "^(prologue|ch[1-5]|end|dev)_[a-z0-9_]+$"
    },
    "background": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$"
    },
    "dialogue": {
      "type": "string",
      "pattern": "^res://game/dialogue/.+\\.dialogue$"
    },
    "enter_cue": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$"
    },
    "enter_cue_repeat": {
      "type": "boolean",
      "description": "true 면 들어올 때마다 진입 대사를 재생"
    },
    "characters": {
      "type": "array",
      "items": {
        "enum": [
          "haneul",
          "byeol"
        ]
      },
      "minItems": 1,
      "maxItems": 2,
      "uniqueItems": true
    },
    "active": {
      "enum": [
        "haneul",
        "byeol"
      ]
    },
    "switch_unlocked": {
      "type": "boolean",
      "description": "flag.ch1.met_in_square 와 상관없이 태그 전환 허용"
    },
    "global_saturation": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "walkable": {
      "type": "array",
      "items": {
        "type": "array",
        "items": {
          "type": "number"
        },
        "minItems": 2,
        "maxItems": 2
      },
      "minItems": 3
    },
    "blockers": {
      "type": "array",
      "items": {
        "type": "array",
        "items": {
          "type": "number"
        },
        "minItems": 4,
        "maxItems": 4
      }
    },
    "spawns": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "items": {
          "type": "number"
        },
        "minItems": 2,
        "maxItems": 2
      }
    },
    "echoes": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          {
            "type": "object",
            "required": [],
            "additionalProperties": false,
            "properties": {
              "slug": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_]*$"
              },
              "at": {
                "type": "array",
                "items": {
                  "type": "number"
                },
                "minItems": 2,
                "maxItems": 2
              },
              "restore_radius": {
                "type": "number",
                "minimum": 8,
                "maximum": 200
              },
              "outline_radius": {
                "type": "number",
                "minimum": 4,
                "maximum": 40
              },
              "id": {
                "type": "string",
                "pattern": "^echo\\.(prologue|ch[1-5])\\.[a-z][a-z0-9_]*$"
              },
              "display_only": {
                "type": "boolean",
                "description": "이전 장면에서 모은 잔향의 색만 남긴다(모았을 때만 놓임, 상호작용 없음)"
              }
            },
            "anyOf": [
              {
                "required": [
                  "slug"
                ]
              },
              {
                "required": [
                  "id"
                ]
              }
            ]
          }
        ]
      }
    },
    "inspectables": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "cue": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "at": {
            "type": "array",
            "items": {
              "type": "number"
            },
            "minItems": 2,
            "maxItems": 2
          },
          "radius": {
            "type": "number",
            "minimum": 8,
            "maximum": 64
          }
        }
      }
    },
    "npcs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "speaker",
          "at"
        ],
        "additionalProperties": false,
        "properties": {
          "speaker": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "sprite": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "at": {
            "type": "array",
            "items": {
              "type": "number"
            },
            "minItems": 2,
            "maxItems": 2
          },
          "cue": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "face_level": {
            "enum": [
              0,
              1,
              2
            ]
          }
        }
      }
    },
    "exits": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "to"
        ],
        "additionalProperties": false,
        "properties": {
          "exit": {
            "type": "string"
          },
          "rect": {
            "type": "array",
            "items": {
              "type": "number"
            },
            "minItems": 4,
            "maxItems": 4
          },
          "to": {
            "type": "string",
            "pattern": "^(prologue|ch[1-5]|end|dev|ui)_[a-z0-9_]+$"
          },
          "spawn": {
            "type": "string"
          },
          "blocked_cue": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "requires": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "flags": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^flag\\.(prologue|ch[1-5]|endings|global)\\.[a-z][a-z0-9_]*$"
                }
              },
              "echoes": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^echo\\.(prologue|ch[1-5])\\.[a-z][a-z0-9_]*$"
                }
              },
              "plots": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^plot_[0-9]{2}$"
                }
              },
              "owner_planted": {
                "enum": [
                  "haneul",
                  "byeol"
                ]
              },
              "inspected": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9_]*$"
                },
                "description": "이번 방문에서 조사한 대상 id"
              },
              "never": {
                "type": "boolean",
                "description": "항상 막힘 (맵 가장자리)"
              }
            }
          }
        }
      }
    },
    "notes": {
      "type": "string"
    },
    "garden": {
      "type": "object",
      "additionalProperties": false,
      "description": "정원 장면이면 칸 배치 (docs/gdd/garden.md). 나갈 때 방문 마무리(틱·꽃)가 돈다.",
      "properties": {
        "rows_y": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "minItems": 2,
          "maxItems": 2
        },
        "x0": {
          "type": "number"
        },
        "dx": {
          "type": "number"
        }
      }
    },
    "gates": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "rect"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "rect": {
            "type": "array",
            "items": {
              "type": "number"
            },
            "minItems": 4,
            "maxItems": 4
          }
        }
      }
    },
    "mechanisms": {
      "type": "array",
      "description": "동시 조작 퍼즐 (docs/gdd/sibling.md §4). hold = 붙잡기-이동, plates = 두 발판",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "type",
          "id",
          "gate"
        ],
        "properties": {
          "type": {
            "enum": [
              "hold",
              "plates"
            ]
          },
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "gate": {
            "type": "string"
          },
          "at": {
            "type": "array",
            "items": {
              "type": "number"
            },
            "minItems": 2,
            "maxItems": 2
          },
          "lock_at": {
            "type": "array",
            "items": {
              "type": "number"
            },
            "minItems": 2,
            "maxItems": 2
          },
          "plates": {
            "type": "array",
            "items": {
              "type": "array",
              "items": {
                "type": "number"
              },
              "minItems": 2,
              "maxItems": 2
            },
            "minItems": 2
          },
          "solved_cue": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "hint_cues": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "hold": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_]*$"
              },
              "switch": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_]*$"
              },
              "latch": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_]*$"
              }
            }
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "type": {
                  "const": "hold"
                }
              }
            },
            "then": {
              "required": [
                "at",
                "lock_at"
              ]
            }
          },
          {
            "if": {
              "properties": {
                "type": {
                  "const": "plates"
                }
              }
            },
            "then": {
              "required": [
                "plates"
              ]
            }
          }
        ]
      }
    },
    "title_card": {
      "type": "string",
      "description": "처음 들어올 때 한 번 보여 줄 제목 카드 i18n 키 (예: chapter.ch1.title)"
    },
    "afterimage": {
      "enum": [
        "longing",
        "warmth",
        "dream",
        "courage",
        "healing"
      ],
      "description": "공감 연결 잔상: 진입 때 이 감정 기호가 0.5초 비친다"
    },
    "tutorials": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "after",
          "text"
        ],
        "properties": {
          "after": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "text": {
            "type": "string",
            "description": "{interact} 같은 자리표시는 지금 키 이름으로 바뀐다"
          }
        }
      }
    },
    "bgm": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$",
      "description": "game/audio/bgm/bgm_<이름>.ogg"
    },
    "ambience": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$",
      "description": "game/audio/sfx/amb/amb_<이름>.ogg"
    },
    "surface": {
      "enum": [
        "wood",
        "stone",
        "grass"
      ],
      "description": "발소리 재질"
    }
  }
}
