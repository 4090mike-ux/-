{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://void-painter.local/schemas/save.schema.json",
  "title": "슬롯 세이브 (user://save_{slot}.json)",
  "description": "SaveService(WP-08)가 쓰고 읽는다. 계산 가능한 값(echo_found 등)은 저장하지 않는다. 스키마를 바꾸면 schema_version 을 올리고 마이그레이션 함수를 추가한다.",
  "type": "object",
  "required": [
    "schema_version",
    "slot",
    "saved_at",
    "game_version",
    "playtime_sec",
    "location",
    "state"
  ],
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schema_version": {
      "const": 1
    },
    "slot": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9,
      "description": "0 = 자동 저장"
    },
    "saved_at": {
      "type": "string",
      "format": "date-time"
    },
    "game_version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+"
    },
    "playtime_sec": {
      "type": "integer",
      "minimum": 0
    },
    "location": {
      "type": "object",
      "required": [
        "chapter",
        "scene",
        "active_character"
      ],
      "additionalProperties": false,
      "properties": {
        "chapter": {
          "enum": [
            "prologue",
            "ch1",
            "ch2",
            "ch3",
            "ch4",
            "ch5",
            "endings"
          ]
        },
        "scene": {
          "type": "string",
          "pattern": "^res://game/scenes/.+\\.tscn$"
        },
        "spawn": {
          "type": "string",
          "description": "씬 안의 스폰 Marker2D 이름"
        },
        "active_character": {
          "enum": [
            "haneul",
            "byeol"
          ]
        }
      }
    },
    "state": {
      "type": "object",
      "required": [
        "vars",
        "flags",
        "echoes_collected",
        "reunited_families",
        "garden"
      ],
      "additionalProperties": false,
      "properties": {
        "vars": {
          "type": "object",
          "required": [
            "protect",
            "heal",
            "bond"
          ],
          "additionalProperties": false,
          "properties": {
            "protect": {
              "type": "integer",
              "minimum": 0
            },
            "heal": {
              "type": "integer",
              "minimum": 0
            },
            "bond": {
              "type": "integer",
              "minimum": 0,
              "maximum": 4
            }
          }
        },
        "flags": {
          "type": "object",
          "description": "기본값과 다른 플래그만 저장한다. 키는 game/data/flags.json 에 있어야 한다(validate_data.py 가 교차 검사).",
          "propertyNames": {
            "pattern": "^flag\\.(prologue|ch[1-5]|endings|global)\\.[a-z][a-z0-9_]*$"
          },
          "additionalProperties": {
            "type": [
              "boolean",
              "integer",
              "string"
            ]
          }
        },
        "echoes_collected": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^echo\\.(prologue|ch[1-5])\\.[a-z][a-z0-9_]*$"
          },
          "uniqueItems": true,
          "maxItems": 30
        },
        "reunited_families": {
          "type": "array",
          "description": "재결합을 마친 사이드 가족 id. families_reunited 는 이 목록의 길이로 계산한다(ADR-0004).",
          "items": {
            "type": "string",
            "pattern": "^family_[a-z0-9_]+$"
          },
          "uniqueItems": true,
          "maxItems": 6
        },
        "choices_made": {
          "type": "array",
          "description": "선택한 성향 선택지 id ([#choice=...]). 디버그·분기 검증용",
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9_]+$"
          },
          "uniqueItems": true
        },
        "garden": {
          "type": "object",
          "required": [
            "plots",
            "bloomed"
          ],
          "additionalProperties": false,
          "properties": {
            "plots": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "id",
                  "planted_by",
                  "emotion",
                  "growth"
                ],
                "additionalProperties": false,
                "properties": {
                  "id": {
                    "type": "string",
                    "pattern": "^plot_[0-9]{2}$"
                  },
                  "planted_by": {
                    "enum": [
                      "haneul",
                      "byeol"
                    ]
                  },
                  "emotion": {
                    "enum": [
                      "longing",
                      "warmth",
                      "dream",
                      "courage",
                      "healing"
                    ]
                  },
                  "growth": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 5
                  },
                  "resonance_bonus": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 5
                  }
                }
              }
            },
            "bloomed": {
              "type": "array",
              "description": "핀 꽃 id (예: family_flower, rainbow_flower, sprout_together)",
              "items": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_]*$"
              },
              "uniqueItems": true
            }
          }
        }
      }
    }
  }
}
